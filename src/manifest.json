{
  "manifest_version": 3,
  "name": "MailMind – Local AI Email Assistant",
  "short_name": "MailMind",
  "version": "0.6.0",
  "description": "Chat with a local AI (Ollama, LM Studio, llama.cpp…) to read, write, review, sort, filter, file and clean up your email. Nothing leaves your computer.",
  "author": "MailMind",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailmind@local.addon",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "MailMind chat",
    "default_label": "MailMind",
    "default_icon": "icons/icon.svg"
  },
  "message_display_action": {
    "default_title": "MailMind",
    "default_icon": "icons/icon.svg",
    "default_popup": "ui/popups/message.html"
  },
  "compose_action": {
    "default_title": "MailMind",
    "default_icon": "icons/icon.svg",
    "default_popup": "ui/popups/compose.html"
  },
  "options_ui": {
    "page": "ui/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "accountsRead",
    "accountsIdentities",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "compose",
    "compose.send",
    "menus",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
